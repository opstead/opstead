{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/opstead/opstead/main/spec/schema/health.schema.json",
  "title": "GET /ops/health",
  "description": "The app's own judgement of itself (OPStead contract 0.5, level 1).",
  "type": "object",
  "required": [
    "checks"
  ],
  "properties": {
    "app": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,64}$",
      "description": "The commit that runs, read from what the build or deploy stamped; counts toward no level."
    },
    "deployed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the running code was put in place; the process's start time when nothing better is known. Counts toward no level."
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "ok",
        "warn",
        "bad"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/check"
      }
    }
  },
  "definitions": {
    "check": {
      "type": "object",
      "required": [
        "id",
        "level"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "level": {
          "enum": [
            "ok",
            "warn",
            "bad"
          ]
        },
        "subject": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      },
      "if": {
        "properties": {
          "level": {
            "enum": [
              "warn",
              "bad"
            ]
          }
        }
      },
      "then": {
        "required": [
          "detail"
        ]
      }
    }
  }
}
